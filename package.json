{
  "name": "calorie_counter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "log": "node --env-file=.env cli.js",
    "dev": "node --env-file=.env server.js",
    "smoke": "node src/smoke.js",
    "seed": "node --env-file=.env src/seed.js",
    "reset": "node -e \"require('fs').writeFileSync('data/foods.json','{}');require('fs').writeFileSync('data/log.json','[]')\"",
    "foods": "node --env-file=.env src/foodfix.js",
    "start": "node server.js",
    "migrate": "node --env-file=.env src/migrate.js",
    "db:migrate": "node --env-file=.env src/dbmigrate.js"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
