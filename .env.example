# Key from the SEPARATE Google account used only for this project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon POOLED connection string (the host contains "-pooler").
# Leave blank to use local JSON files in data/ instead.
DATABASE_URL=

# Required in production. When unset the app assumes local dev and lets
# everything through.
APP_PASSCODE=

# --- accounts (optional locally; required for multi-user) ---
# From Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback
#   https://<your-app>.onrender.com/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies AND encrypts users' stored Gemini keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CHANGING THIS LOGS EVERYONE OUT AND MAKES STORED KEYS UNREADABLE.
SESSION_SECRET=

# Your Google account email. On first sign-in it adopts every row logged
# before accounts existed, so your own history is not stranded.
OWNER_EMAIL=
