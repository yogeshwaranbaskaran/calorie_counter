# Key from the SEPARATE Google account used only for this project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon POOLED connection string (the host contains "-pooler").
# Leave blank to use local JSON files in data/ instead.
DATABASE_URL=

# Required in production. When unset the app assumes local dev and lets
# everything through.
APP_PASSCODE=
