{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 300 },
    "api/insights.js": { "maxDuration": 120 }
  },
  "headers": [
    { "source": "/(index.html)?", "headers": [{ "key": "cache-control", "value": "no-store" }] }
  ]
}
